:host {
  display: block;
}
.ev {
  padding: 20rpx 20rpx 28rpx;
  border-radius: 52rpx;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.ev-text {
  padding: 0 12rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.ev-title {
  font-size: 34rpx;
  font-weight: 800;
}
.ev-meta {
  font-size: 26rpx;
  color: #5B5F68;
}
.ev-foot {
  padding: 0 12rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.ev-count {
  font-size: 26rpx;
  color: #3D4048;
}
.ev-fee {
  margin-left: auto;
  padding: 10rpx 20rpx;
}
