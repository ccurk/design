:host {
  display: block;
}
.ev {
  padding: 16rpx 16rpx 28rpx;
  border-radius: 48rpx;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}
.ev-media {
  position: relative;
}
.ev-badges {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  right: 160rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.ev-badge {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #15171C;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.4;
}
.ev-status {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.4;
}
.ev-status.soon {
  background: #7CCAE3;
  color: #15171C;
}
.ev-status.full {
  background: rgba(21, 23, 28, 0.7);
  color: #FFFFFF;
}
.ev-text {
  padding: 0 12rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.ev-title {
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.35;
}
.ev-meta {
  font-size: 26rpx;
  color: #5B5F68;
}
.ev-foot {
  padding: 0 12rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.ev-count {
  font-size: 26rpx;
  color: #3D4048;
}
.ev-fee {
  margin-left: auto;
  padding: 10rpx 20rpx;
}
/* 横滑小卡 */
.ev-compact {
  padding: 12rpx 12rpx 20rpx;
  border-radius: 36rpx;
  gap: 14rpx;
}
.ev-compact .ev-title {
  font-size: 28rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.ev-compact .ev-meta {
  font-size: 22rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.ev-compact .ev-text,
.ev-compact .ev-foot {
  padding: 0 8rpx;
}
.ev-compact .ev-count {
  font-size: 22rpx;
}
.ev-compact .ev-badges {
  left: 12rpx;
  top: 12rpx;
  right: 120rpx;
}
.ev-compact .ev-status {
  right: 12rpx;
  top: 12rpx;
}
