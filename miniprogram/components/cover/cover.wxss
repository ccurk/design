:host {
  display: block;
  flex-shrink: 0;
}
.cover {
  position: relative;
  overflow: hidden;
}
.cover-full {
  position: absolute;
  left: 0;
  bottom: 0;
  display: block;
}
.cover-center {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cover-art {
  display: block;
}
