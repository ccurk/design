<view class="cover" style="{{boxStyle}}">
  <image wx:if="{{full}}" class="cover-full" src="{{src}}" mode="aspectFill" style="{{imgStyle}}" />
  <view wx:else class="cover-center" style="{{innerStyle}}">
    <image class="cover-art" src="{{src}}" mode="aspectFit" style="{{imgStyle}}" />
  </view>
</view>
