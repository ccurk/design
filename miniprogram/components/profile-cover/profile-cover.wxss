:host {
  display: block;
}
.pc {
  position: relative;
  overflow: hidden;
  background: var(--stone);
}
.pc-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}
/* 照片 / 深色插画顶部压暗一点，状态栏的白字才看得清 */
.pc-shade {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  background: linear-gradient(180deg, rgba(10, 20, 28, 0.42), rgba(10, 20, 28, 0));
  pointer-events: none;
}
/* 「更换背景」停在背景右下角，避开下面盖上来的资料卡（48rpx） */
.pc-edit {
  position: absolute;
  right: 32rpx;
  bottom: 76rpx;
  height: 56rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: rgba(21, 23, 28, 0.46);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 8rpx;
}
/* 按钮看着小，点击区域放大到 44px 左右 */
.pc-edit::after {
  content: '';
  position: absolute;
  top: -16rpx;
  bottom: -16rpx;
  left: -12rpx;
  right: -12rpx;
}
.pc-sentinel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 48rpx;
  height: 1px;
  pointer-events: none;
}
.pc-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  pointer-events: none;
}
.pc-bar.on {
  pointer-events: auto;
}
.pc-bar-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--ground);
  box-shadow: 0 1px 0 var(--divider);
  opacity: 0;
  transition: opacity 0.2s;
}
.pc-title {
  position: absolute;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
  opacity: 0;
  transition: opacity 0.2s;
}
.pc-bar.on .pc-bar-bg,
.pc-bar.on .pc-title {
  opacity: 1;
}
.pc-back {
  position: absolute;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: auto;
  transition: background 0.2s;
}
.pc-back.on-light {
  background: rgba(255, 255, 255, 0.78);
}
.pc-back.on-dark {
  background: rgba(21, 23, 28, 0.32);
}
.pc-back.flat {
  background: transparent;
}
.pc-back-ico {
  width: 40rpx;
  height: 40rpx;
}
