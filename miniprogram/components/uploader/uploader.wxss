:host {
  display: block;
}
.up {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.up-cell {
  position: relative;
  flex-shrink: 0;
  border-radius: 28rpx;
  overflow: hidden;
  background: #E3E8EC;
}
.up-img {
  width: 100%;
  height: 100%;
  display: block;
}
.up-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(21, 23, 28, 0.45);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}
.up-progress {
  font-size: 26rpx;
  font-weight: 700;
  color: #FFFFFF;
}
.up-bar {
  width: 60%;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.35);
  overflow: hidden;
}
.up-bar-in {
  height: 8rpx;
  border-radius: 999rpx;
  background: #7CCAE3;
}
.up-error {
  background: rgba(180, 35, 24, 0.6);
}
.up-retry {
  font-size: 22rpx;
  color: #FFFFFF;
}
.up-remove {
  position: absolute;
  top: 0;
  right: 0;
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: flex-start;
  justify-content: flex-end;
}
.up-x {
  margin: 10rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
}
.up-add {
  border: 1px dashed #B8C0C7;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}
.up-count {
  font-size: 22rpx;
  color: #5B5F68;
}
.up-cover {
  position: absolute;
  left: 0;
  bottom: 0;
  padding: 4rpx 16rpx;
  border-radius: 0 20rpx 0 0;
  background: rgba(21, 23, 28, 0.6);
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 700;
}
