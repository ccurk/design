<view class="empty {{compact ? 'empty-compact' : ''}}">
  <view wx:if="{{icon}}" class="empty-mark">
    <image class="empty-icon" src="{{icon}}" />
  </view>
  <view class="empty-title">{{title}}</view>
  <view wx:if="{{desc}}" class="empty-desc">{{desc}}</view>
  <view class="empty-actions">
    <slot></slot>
  </view>
</view>
