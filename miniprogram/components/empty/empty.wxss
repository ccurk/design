:host {
  display: block;
}
.empty {
  padding: 120rpx 64rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  text-align: center;
}
.empty-compact {
  padding: 48rpx 40rpx 24rpx;
}
.empty-mark {
  width: 128rpx;
  height: 128rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
}
.empty-icon {
  width: 56rpx;
  height: 56rpx;
}
.empty-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #15171C;
}
.empty-desc {
  font-size: 28rpx;
  line-height: 1.6;
  color: #5B5F68;
}
.empty-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding-top: 16rpx;
}
