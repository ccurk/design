:host {
  display: block;
}
.cal {
  padding: 0 32rpx 8rpx;
}
.cal-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 12rpx 16rpx;
}
.cal-month {
  font-size: 30rpx;
  font-weight: 800;
}
.cal-picked {
  font-size: 28rpx;
  font-weight: 700;
  color: #193543;
}
.cal-head,
.cal-grid {
  display: flex;
  flex-wrap: wrap;
}
.cal-head {
  padding-bottom: 8rpx;
  font-size: 24rpx;
  color: #5B5F68;
}
.cal-cell {
  width: 14.2857%;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}
.cal-grid .cal-cell {
  height: 92rpx;
}
.cal-day {
  width: 80rpx;
  height: 80rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
  color: #15171C;
}
.cal-day.today {
  border: 2rpx solid #D3DAE0;
}
.cal-day.month {
  font-size: 22rpx;
  font-weight: 700;
}
.cal-day.off {
  color: #C7CDD3;
  border-color: transparent;
}
.cal-day.on {
  background: #193543;
  border-color: #193543;
  color: #FFFFFF;
  font-weight: 700;
}
.cal-note {
  padding: 12rpx 0 8rpx;
  text-align: center;
  font-size: 24rpx;
  color: #5B5F68;
}
