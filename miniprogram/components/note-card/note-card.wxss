:host {
  display: block;
}
.nc {
  border-radius: 32rpx;
  background: #FFFFFF;
  overflow: hidden;
}
.nc-media {
  position: relative;
  background: #E3E8EC;
}
.nc-wait {
  min-height: 400rpx;
}
.nc-broken {
  height: 260rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.4;
}
.nc-img {
  display: block;
  width: 100%;
}
.nc-count {
  position: absolute;
  right: 12rpx;
  top: 12rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(21, 23, 28, 0.55);
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 700;
}
.nc-textcard {
  min-height: 280rpx;
  padding: 36rpx 28rpx;
  display: flex;
  align-items: center;
}
.nc-quote {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 6;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.tone-sky {
  background: #DFF1F7;
  color: #193543;
}
.tone-stone {
  background: #E3E8EC;
  color: #15171C;
}
.tone-ink {
  background: #193543;
  color: #FFFFFF;
}
.nc-body {
  padding: 18rpx 20rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.nc-title {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.45;
  color: #15171C;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.nc-pending {
  align-self: flex-start;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  background: #E1E7EC;
  font-size: 20rpx;
  font-weight: 700;
}
.nc-event {
  font-size: 22rpx;
  font-weight: 700;
  color: #2E4A5C;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.nc-foot {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.nc-name {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: #5B5F68;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.nc-like {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 6rpx;
  min-height: 64rpx;
  padding-left: 12rpx;
  font-size: 22rpx;
  color: #5B5F68;
}
