<view class="tab-bar">
  <view wx:for="{{list}}" wx:key="url" class="tab-item {{selected === index ? 'on' : ''}}" data-index="{{index}}" bindtap="switchTab" aria-role="tab" aria-selected="{{selected === index}}">
    <view class="tab-pill">
      <image class="tab-icon" src="{{selected === index ? item.iconOn : item.icon}}" />
    </view>
    <text class="tab-text">{{item.text}}</text>
  </view>
</view>
