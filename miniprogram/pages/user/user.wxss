.head {
  padding: 8rpx 40rpx 0;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.name {
  font-size: 48rpx;
  line-height: 1.2;
  font-weight: 800;
}
.bio {
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--body);
}
.stats {
  margin: 32rpx 32rpx 0;
  padding: 36rpx 16rpx 28rpx;
  border-radius: 48rpx;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.stats-grid {
  display: flex;
}
.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.stat-num {
  font-size: 52rpx;
  font-weight: 800;
  letter-spacing: -0.02em;
}
.stat-label {
  font-size: 24rpx;
  color: var(--text-2);
}
.stats-line {
  height: 1px;
  margin: 0 24rpx;
  background: var(--divider);
}
.stats-note {
  padding: 0 24rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--text-2);
}
.points {
  margin: 28rpx 40rpx 0;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
}
.points-label {
  margin-right: 4rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-2);
}
.point-white {
  background: #FFFFFF;
}
.recent-label {
  margin: 36rpx 40rpx 16rpx;
  padding: 0;
}
.recent {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 112rpx;
  padding: 0 24rpx 0 32rpx;
}
.gap-2 {
  gap: 4rpx;
}
.foot-note {
  margin: 24rpx 40rpx 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  color: var(--text-2);
}
.bar {
  display: flex;
  gap: 20rpx;
  padding-left: 32rpx;
  padding-right: 32rpx;
}
.blocked {
  background: var(--ground);
  border: 1px solid var(--hairline);
  color: var(--body);
}
