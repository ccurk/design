.form {
  padding: 16rpx 32rpx 0;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}
.box {
  padding: 32rpx;
  border-radius: 48rpx;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.avatar-row {
  flex-direction: row;
  align-items: center;
  gap: 32rpx;
}
.gap-2 {
  gap: 4rpx;
}
.cover-thumb {
  flex-shrink: 0;
  width: 128rpx;
  height: 128rpx;
  border-radius: 28rpx;
  overflow: hidden;
  background: var(--stone);
}
.cover-thumb-img {
  display: block;
  width: 100%;
  height: 100%;
}
.change {
  font-size: 28rpx;
  padding: 0 32rpx;
}
.label-gap {
  padding-top: 12rpx;
}
.bio {
  height: 160rpx;
}
.baseline {
  align-items: baseline;
}
.small {
  padding: 0 28rpx;
  font-size: 28rpx;
}
.gender {
  padding: 0 36rpx;
}
