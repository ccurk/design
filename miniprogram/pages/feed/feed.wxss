.head {
  padding: 8rpx 32rpx 0 40rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.compose {
  width: 88rpx;
  height: 88rpx;
  border-radius: 999rpx;
  background: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
}
.sub {
  margin: 8rpx 40rpx 0;
  font-size: 28rpx;
  color: var(--text-2);
}
/* 双列瀑布流 */
.falls {
  padding: 28rpx 24rpx 0;
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}
.fall {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}
.more-retry {
  min-height: 88rpx;
  color: var(--primary);
  font-weight: 700;
}
