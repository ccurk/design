<view class="page">
  <view class="head">
    <view class="big-title">动态</view>
    <view class="compose" hover-class="pressed" bindtap="goCompose" aria-label="发动态">
      <image class="ico-20" src="/assets/icons/plus-white.svg" />
    </view>
  </view>
  <view class="sub">局结束后的花絮，先看看氛围再决定去不去</view>

  <view class="list">
    <dz-post-card wx:for="{{posts}}" wx:key="id" post="{{item}}" bindlike="onLike" bindmore="onMore" bindopen="onOpen" />
  </view>

  <view wx:if="{{loading && !posts.length}}" class="loading">加载中…</view>
  <dz-empty wx:elif="{{!posts.length}}" title="{{error ? '暂时加载不出来' : '还没有动态'}}" desc="{{error ? error : '局结束后，来这里留点花絮吧。'}}" icon="/assets/icons/image-primary.svg">
    <view wx:if="{{error}}" class="btn btn-sm btn-primary" bindtap="refresh">再试一次</view>
    <view wx:else class="btn btn-sm btn-primary" bindtap="goCompose">发一条</view>
  </dz-empty>
  <view wx:elif="{{loadingMore}}" class="load-more">加载中…</view>
  <view wx:elif="{{!nextCursor}}" class="load-more">没有更多了</view>

  <view class="tab-space"></view>
</view>
