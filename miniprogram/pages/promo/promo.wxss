.loading {
  padding: 80rpx;
  text-align: center;
  color: var(--text-2);
}
.page {
  min-height: 100vh;
  background: var(--ground);
}
.cover {
  width: 100%;
  display: block;
}
.body {
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.tag {
  align-self: flex-start;
  font-size: 22rpx;
  color: #8A94A6;
  background: #FFFFFF;
  border: 1px solid var(--hairline);
  border-radius: 999rpx;
  padding: 2rpx 16rpx;
}
.title {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--ink);
  line-height: 1.3;
}
.subtitle {
  font-size: 28rpx;
  color: var(--text-2);
}
.text {
  font-size: 30rpx;
  color: var(--ink);
  line-height: 1.7;
  white-space: pre-wrap;
}
.cta {
  margin-top: 16rpx;
}
.coop {
  margin: 8rpx 32rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: #8A94A6;
  background: #FFFFFF;
  border-radius: 24rpx;
}
