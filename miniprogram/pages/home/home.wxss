.loc {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 40rpx 0;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-2);
}
.intro {
  padding: 28rpx 40rpx 0;
  display: flex;
  flex-direction: column;
}
.intro .lead {
  margin-top: 16rpx;
}
.intro .lead-2 {
  margin-top: 0;
}
.form {
  margin: 32rpx 32rpx 0;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}
.mine {
  margin: 36rpx 32rpx 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.intent {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 20rpx 24rpx 28rpx;
  background: var(--surface);
  border-radius: 40rpx;
}
.gap-2 {
  gap: 4rpx;
}
