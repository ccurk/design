.top {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 8rpx 32rpx 0 40rpx;
}
.loc {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-2);
}
.top-search {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: var(--surface);
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: var(--muted);
}
.intro {
  padding: 28rpx 40rpx 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.err {
  margin: 28rpx 32rpx 0;
  padding: 16rpx 16rpx 16rpx 28rpx;
  border-radius: 32rpx;
  background: var(--pill);
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: var(--body);
}
.err-retry {
  flex-shrink: 0;
  min-height: 88rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: var(--primary);
  color: #FFFFFF;
  font-weight: 700;
  display: flex;
  align-items: center;
}

/* 轮播 */
.banner-wrap {
  margin: 32rpx 32rpx 0;
  border-radius: 40rpx;
  overflow: hidden;
  transform: translateZ(0);
}
.banner {
  height: 300rpx;
}
.banner-item {
  position: relative;
  width: 100%;
  height: 100%;
}
.banner-img {
  display: block;
  width: 100%;
  height: 100%;
  background: var(--stone);
}
.banner-shade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 60%;
  background: linear-gradient(180deg, rgba(21, 23, 28, 0) 0%, rgba(21, 23, 28, 0.55) 100%);
}
.banner-text {
  position: absolute;
  left: 36rpx;
  right: 36rpx;
  bottom: 60rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  color: #FFFFFF;
}
.banner-title {
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.3;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}
.banner-sub {
  font-size: 26rpx;
  opacity: 0.92;
}

/* 宫格 */
.pick {
  margin: 28rpx 32rpx 0;
  padding: 32rpx 24rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}
.pick-head {
  padding: 0 12rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.pick-title {
  font-size: 34rpx;
  font-weight: 800;
}
.pick-hint {
  font-size: 24rpx;
  color: var(--text-2);
}
.grid {
  display: flex;
  flex-wrap: wrap;
  row-gap: 24rpx;
}
.grid-item {
  width: 20%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}
.grid-tile {
  width: 104rpx;
  height: 104rpx;
  border-radius: 32rpx;
  overflow: hidden;
  background: var(--stone);
  border: 4rpx solid transparent;
  display: flex;
  align-items: center;
  justify-content: center;
}
.grid-tile.on {
  border-color: var(--accent);
}
.grid-img {
  width: 100%;
  height: 100%;
}
.grid-more {
  background: var(--ground);
}
.grid-add {
  background: var(--surface);
  border: 3rpx dashed var(--faint);
}
.grid-name {
  max-width: 100%;
  font-size: 24rpx;
  color: var(--ink);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.cta {
  margin: 0 8rpx;
}
.cta-text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.pick .row.between {
  padding: 0 8rpx;
}

/* 人气 */
.proof {
  margin: 24rpx 40rpx 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.proof-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: var(--text-2);
}
.proof-num {
  font-weight: 800;
  color: var(--ink);
}

/* 分区 */
.sec {
  margin-top: 44rpx;
}
.sec-head {
  min-height: 72rpx;
  padding: 0 32rpx 0 40rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.sec-title {
  font-size: 34rpx;
  font-weight: 800;
}
.mine {
  margin: 12rpx 32rpx 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.intent {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 20rpx 20rpx 20rpx 20rpx;
  background: var(--surface);
  border-radius: 40rpx;
}
.gap-2 {
  gap: 4rpx;
}
.hscroll {
  margin-top: 12rpx;
  width: 100%;
  white-space: nowrap;
}
.hrow {
  display: inline-flex;
  gap: 20rpx;
  padding: 0 32rpx 8rpx;
}
.hl {
  width: 280rpx;
  border-radius: 32rpx;
  overflow: hidden;
  background: var(--surface);
  white-space: normal;
  display: flex;
  flex-direction: column;
}
.hl-img {
  display: block;
  width: 280rpx;
  height: 350rpx;
  background: var(--stone);
}
.hl-body {
  padding: 16rpx 20rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.hl-text {
  height: 76rpx;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.45;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.hl-user {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.hl-name {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: var(--text-2);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.fe {
  width: 440rpx;
  white-space: normal;
}

/* 自己发起 */
.create {
  margin: 44rpx 32rpx 0;
  padding: 20rpx 28rpx 20rpx 20rpx;
  border-radius: 40rpx;
  background: var(--surface);
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.create-img {
  flex-shrink: 0;
  width: 144rpx;
  height: 112rpx;
  border-radius: 24rpx;
  background: var(--stone);
}

/* 约搭子弹窗 */
.ms {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 0 40rpx 8rpx;
}
.ms-tag {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 24rpx 16rpx 16rpx;
  border-radius: 32rpx;
  background: var(--ground);
}
.ms-tag-img {
  flex-shrink: 0;
  width: 120rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: var(--stone);
}
.ms-mini {
  font-size: 22rpx;
  color: var(--text-2);
}
.ms-tag-name {
  font-size: 34rpx;
  font-weight: 800;
}
.ms-change {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--primary);
}
.ms-label {
  padding-top: 12rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-2);
}
.ms-ico {
  margin-right: 8rpx;
}
.ms-samesex {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.ms-note {
  margin-top: 8rpx;
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--text-2);
}
.ms-note .ico-14 {
  margin-top: 4rpx;
}
.ms-foot {
  padding: 16rpx 40rpx 24rpx;
}
.ms-foot .btn {
  font-size: 30rpx;
}
