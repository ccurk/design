.head {
  padding: 8rpx 32rpx 0 40rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.create {
  font-size: 28rpx;
  gap: 8rpx;
}
.round-btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.sub {
  margin: 8rpx 40rpx 0;
  font-size: 28rpx;
  color: var(--text-2);
}
/* 吸顶：不跟着列表滑走 */
.filters {
  position: sticky;
  top: 0;
  z-index: 10;
  margin-top: 16rpx;
  padding: 12rpx 0;
  background: var(--ground);
}
.tags {
  width: 100%;
  white-space: nowrap;
}
.tags-inner {
  display: inline-flex;
  gap: 16rpx;
  padding: 0 40rpx;
}
/* 选中前后尺寸完全一致，点选时不跳动 */
.tab {
  flex-shrink: 0;
  height: 88rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  border: 1px solid var(--hairline);
  background: var(--surface);
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 86rpx;
  box-sizing: border-box;
}
.tab.on {
  background: var(--primary);
  border-color: var(--primary);
  color: #FFFFFF;
}
.subfilters {
  display: flex;
  gap: 12rpx;
  padding: 10rpx 24rpx 0;
}
.chip-sf {
  height: 56rpx;
  line-height: 54rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  border: 1px solid var(--hairline);
  background: var(--surface);
  font-size: 24rpx;
  color: #5A6472;
}
.chip-sf.on {
  background: var(--primary);
  border-color: var(--primary);
  color: #FFFFFF;
}
.list {
  min-height: 100vh;
  padding: 16rpx 32rpx 0;
}
.cards {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  transition: opacity 0.15s;
}
.cards.dim {
  opacity: 0.5;
}
.more-retry {
  min-height: 88rpx;
  color: var(--primary);
  font-weight: 700;
}
