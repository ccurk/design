.form {
  padding: 16rpx 32rpx 0;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}
.banner {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 28rpx;
  border-radius: 32rpx;
  background: var(--pill);
  font-size: 26rpx;
  line-height: 1.5;
}
.box {
  padding: 32rpx;
  border-radius: 48rpx;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.box-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}
.box-hint {
  font-size: 24rpx;
  color: var(--text-2);
}
.gap-2 {
  gap: 4rpx;
}
.chip-add {
  gap: 8rpx;
  border-style: dashed;
  border-color: var(--faint);
}
.suggest {
  align-self: flex-start;
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-height: 72rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: var(--ground);
  font-size: 26rpx;
  font-weight: 700;
  color: var(--primary);
}
/* 一组可点的行（时间 / 地点 / 退出时间…） */
.rows {
  padding: 8rpx 0;
  gap: 0;
}
.pick-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 128rpx;
  padding: 20rpx 28rpx 20rpx 32rpx;
}
.row-label {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-2);
}
.row-value {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.45;
}
.row-sub {
  font-size: 24rpx;
  color: var(--text-2);
}
.step-btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 999rpx;
  border: 1px solid var(--outline);
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
}
.step-btn.off {
  opacity: 0.4;
}
.step-num {
  min-width: 64rpx;
  text-align: center;
  font-size: 36rpx;
  font-weight: 800;
}
.per {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16rpx;
}
.per-input {
  width: 192rpx;
  height: 88rpx;
  border-radius: 24rpx;
}
.switches {
  padding: 8rpx 16rpx 8rpx 32rpx;
  gap: 0;
}
.sw-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 128rpx;
}
.desc {
  height: 200rpx;
}
.phrases {
  gap: 12rpx;
  margin-top: -4rpx;
}
.phrase {
  min-height: 64rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: var(--ground);
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: var(--body);
}

/* 最晚退出时间弹窗 */
.xs {
  padding: 0 40rpx 16rpx;
}
.xs-intro {
  padding: 0 0 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--text-2);
}
.xs-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 120rpx;
}
.xs-row.off {
  opacity: 0.42;
}
.xs-label {
  font-size: 30rpx;
  font-weight: 700;
}
.xs-rec {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--primary);
}
.xs-time {
  font-size: 24rpx;
  color: var(--text-2);
}
.xs-note {
  padding-top: 12rpx;
  font-size: 24rpx;
  color: var(--text-2);
}

/* 谁可以报名弹窗 */
.gs {
  padding: 0 40rpx 16rpx;
  display: flex;
  flex-direction: column;
}
.gs-opt {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 112rpx;
  font-size: 32rpx;
  font-weight: 700;
}
.gs-box {
  width: 44rpx;
  height: 44rpx;
  border-radius: 14rpx;
  border: 4rpx solid var(--faint);
  display: flex;
  align-items: center;
  justify-content: center;
}
.gs-opt.on .gs-box {
  border-color: var(--primary);
  background: var(--primary);
}
.gs-opt.lock .gs-box {
  border-color: var(--primary-2);
  background: var(--primary-2);
}
.gs-opt.off {
  color: var(--faint);
}
.gs-me {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-2);
}
.gs-hint {
  padding-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-2);
}
.gs-tip {
  margin-top: 20rpx;
  padding-right: 12rpx;
}
