.head {
  padding: 16rpx 40rpx 0;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.edit {
  padding: 0 36rpx;
  font-size: 28rpx;
}
.name {
  font-size: 48rpx;
  line-height: 1.3;
  font-weight: 800;
}
.bio {
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--text-2);
}
.stats {
  margin: 36rpx 32rpx 0;
  padding: 36rpx 16rpx 12rpx;
  border-radius: 48rpx;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.stats-grid {
  display: flex;
}
.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.stat-num {
  font-size: 52rpx;
  font-weight: 800;
  letter-spacing: -0.02em;
}
.stat-label {
  font-size: 24rpx;
  color: var(--text-2);
}
.stats-line {
  height: 1px;
  margin: 12rpx 24rpx 0;
  background: var(--divider);
}
.credit-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 88rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  color: var(--body);
}
.turn {
  transform: rotate(90deg);
}
.records {
  margin: 0 24rpx 12rpx;
  border-top: 1px solid var(--divider);
}
.record {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 112rpx;
  padding: 12rpx 0;
  border-bottom: 1px solid var(--divider);
}
.gap-2 {
  gap: 4rpx;
}
.appeal-btn {
  font-size: 26rpx;
}
.menu {
  margin: 28rpx 32rpx 0;
  padding: 8rpx 0;
  border-radius: 48rpx;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
}
.menu-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 112rpx;
  padding: 0 32rpx;
}
.menu-row.tall {
  min-height: 128rpx;
}
.menu-ico {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: var(--ground);
  display: flex;
  align-items: center;
  justify-content: center;
}
.contact {
  display: block;
  width: 100%;
}
.tl {
  text-align: left;
}
