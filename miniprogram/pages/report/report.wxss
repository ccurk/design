.form {
  padding: 16rpx 32rpx 0;
  display: flex;
  flex-direction: column;
  gap: 36rpx;
}
.baseline {
  align-items: baseline;
}
.reason {
  padding: 0 28rpx;
  font-size: 28rpx;
}
.detail-area {
  height: 192rpx;
  border-radius: 32rpx;
}
.shots {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.shot,
.shot-add {
  position: relative;
  width: 152rpx;
  height: 152rpx;
  border-radius: 32rpx;
}
.shot {
  overflow: hidden;
  background: var(--stone);
}
.shot-img {
  width: 100%;
  height: 100%;
}
.shot-remove {
  position: absolute;
  top: 0;
  right: 0;
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: flex-start;
  justify-content: flex-end;
}
.shot-x {
  margin: 10rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
}
.shot-add {
  border: 1px dashed var(--faint);
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
}
.also {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 88rpx;
  font-size: 28rpx;
}
.check {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  border: 3rpx solid var(--faint);
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
}
.check.on {
  border-color: var(--primary);
  background: var(--primary);
}
