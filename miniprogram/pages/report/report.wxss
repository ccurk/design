.form {
  padding: 16rpx 32rpx 0;
  display: flex;
  flex-direction: column;
  gap: 36rpx;
}
.baseline {
  align-items: baseline;
}
.reason {
  padding: 0 28rpx;
  font-size: 28rpx;
}
.detail-area {
  height: 192rpx;
  border-radius: 32rpx;
}
.also {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 88rpx;
  font-size: 28rpx;
}
.check {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  border: 3rpx solid var(--faint);
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
}
.check.on {
  border-color: var(--primary);
  background: var(--primary);
}