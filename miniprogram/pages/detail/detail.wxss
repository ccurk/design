page {
  background: #FFFFFF;
}
.detail {
  min-height: 100vh;
  background: #FFFFFF;
}
/* 照片轮播 */
.gallery {
  position: relative;
  height: 600rpx;
  background: var(--stone);
}
.gallery-swiper {
  height: 600rpx;
}
.gallery-img {
  display: block;
  width: 100%;
  height: 100%;
}
.gallery-count {
  position: absolute;
  right: 32rpx;
  bottom: 88rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(21, 23, 28, 0.55);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
}
.sheet {
  position: relative;
  margin-top: -56rpx;
  padding: 44rpx 40rpx 0;
  border-radius: 56rpx 56rpx 0 0;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  gap: 36rpx;
}
.tags {
  flex-wrap: wrap;
}
.report {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 88rpx;
  font-size: 26rpx;
  color: var(--text-2);
}
.title {
  font-size: 48rpx;
  line-height: 1.3;
  font-weight: 800;
  letter-spacing: -0.01em;
}
.host-badge {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 999rpx;
  background: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
}
.gap-2 {
  gap: 4rpx;
}
.infos {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.info {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 88rpx;
}
.map-link {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 6rpx;
  min-height: 72rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: var(--ground);
  font-size: 24rpx;
  font-weight: 700;
  color: var(--primary);
}
.info-ico {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  background: var(--ground);
  display: flex;
  align-items: center;
  justify-content: center;
}
.desc {
  padding: 24rpx 28rpx;
  border-radius: 28rpx;
  border: 1px solid var(--hairline);
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--body);
  white-space: pre-wrap;
}
.members-scroll {
  width: 100%;
  white-space: nowrap;
}
.members {
  display: inline-flex;
  gap: 28rpx;
}
.member {
  width: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.member-name {
  width: 96rpx;
  font-size: 24rpx;
  color: var(--body);
  text-align: center;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.seat-44 {
  width: 88rpx;
  height: 88rpx;
}
.apps {
  padding: 24rpx 28rpx;
  border-radius: 36rpx;
  background: var(--ground);
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.app-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.tip-box {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 28rpx;
  border-radius: 36rpx;
  background: var(--ground);
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--body);
}
.tip-ico {
  margin-top: 4rpx;
}
.leave {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.leave-btn {
  min-height: 88rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--danger);
}
.leave-btn.off {
  color: var(--faint);
}
.leave-reason {
  padding: 0 32rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--text-2);
  text-align: center;
}
.host-cancel {
  align-self: center;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--danger);
}
.bar {
  display: flex;
  align-items: center;
  gap: 32rpx;
}
.cta {
  padding: 0 64rpx;
  font-size: 32rpx;
}
.bar .native-btn .cta {
  padding: 0 40rpx;
  font-size: 30rpx;
}
