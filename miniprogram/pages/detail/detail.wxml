<dz-skeleton wx:if="{{loading}}" type="detail" />

<dz-empty wx:elif="{{error}}" title="看不到这个局" desc="{{error}}" icon="/assets/icons/compass-primary.svg">
  <view class="btn btn-sm btn-primary" hover-class="pressed" bindtap="retry">重新加载</view>
  <view class="btn btn-sm btn-ghost" hover-class="pressed" bindtap="goSquare">去广场看看</view>
</dz-empty>

<view wx:else class="detail">
  <!-- 照片：可以左右滑，点开看大图；没有照片用标签插画 -->
  <view wx:if="{{images.length}}" class="gallery">
    <swiper class="gallery-swiper" current="{{imageIndex}}" bindchange="onSwiper">
      <swiper-item wx:for="{{images}}" wx:key="*this">
        <image class="gallery-img" src="{{item}}" mode="aspectFill" lazy-load data-index="{{index}}" bindtap="previewImage" />
      </swiper-item>
    </swiper>
    <text wx:if="{{images.length > 1}}" class="gallery-count">{{imageIndex + 1}}/{{images.length}}</text>
  </view>
  <dz-cover wx:else variant="hero" cover-key="{{event.coverKey}}" category="{{event.category}}" task="{{event.tag || event.task}}" title="{{event.title}}" />

  <view class="sheet">
    <view class="col gap-10">
      <view class="row gap-6 tags">
        <text class="pill pill-accent">{{sourceLabel}}</text>
        <text wx:if="{{event.tag || event.task}}" class="pill pill-outline"># {{event.tag || event.task}}</text>
        <text wx:if="{{event.genderLabel}}" class="pill pill-outline">{{event.genderLabel}}</text>
        <text wx:if="{{event.requireApproval}}" class="pill pill-outline">需发起人同意</text>
        <view class="report" hover-class="pressed" bindtap="report" aria-role="button">
          <image class="ico-14" src="/assets/icons/flag-gray.svg" />
          <text>举报</text>
        </view>
      </view>
      <view class="title">{{event.title}}</view>
      <view class="row gap-8 t-13 c-2">
        <block wx:if="{{event.source === 'user' && event.host}}">
          <view hover-class="pressed" data-id="{{event.host.id}}" bindtap="openUser">
            <dz-avatar user="{{event.host}}" size="22" />
          </view>
          <text>{{event.host.nickname}} 发起 · 履约 {{event.host.creditRate}}%</text>
        </block>
        <block wx:else>
          <view class="host-badge"><image class="ico-12" src="/assets/icons/people-accent.svg" /></view>
          <text>{{hostLine}}</text>
        </block>
      </view>
    </view>

    <view class="infos">
      <view class="info">
        <view class="info-ico"><image class="ico-20" src="/assets/icons/clock-ink.svg" /></view>
        <view class="flex1 col gap-2">
          <text class="t-15 w7">{{dateFull}}</text>
          <text wx:if="{{durationText}}" class="t-13 c-2">{{durationText}}</text>
        </view>
      </view>
      <view class="info" hover-class="{{hasMap ? 'pressed' : 'none'}}" bindtap="openMap" aria-role="{{hasMap ? 'link' : ''}}">
        <view class="info-ico"><image class="ico-20" src="/assets/icons/pin-ink.svg" /></view>
        <view class="flex1 col gap-2">
          <text class="t-15 w7">{{event.place}}</text>
          <text wx:if="{{placeSub}}" class="t-13 c-2">{{placeSub}}</text>
        </view>
        <view wx:if="{{hasMap}}" class="map-link">
          <image class="ico-16" src="/assets/icons/map-primary.svg" />
          <text>地图</text>
        </view>
      </view>
      <view class="info">
        <view class="info-ico"><image class="ico-20" src="/assets/icons/wallet-ink.svg" /></view>
        <view class="flex1 col gap-2">
          <text class="t-15 w7">{{feeTitle}}</text>
          <text class="t-13 c-2">{{feeNote}}</text>
        </view>
      </view>
      <view wx:if="{{event.exitDeadlineLabel && event.phase !== 'ended'}}" class="info">
        <view class="info-ico"><image class="ico-20" src="/assets/icons/hourglass-gray.svg" /></view>
        <view wx:if="{{exitPassed}}" class="flex1 col gap-2">
          <text class="t-15 w7">最晚退出时间已过（{{event.exitDeadlineLabel}}）</text>
          <text class="t-13 c-2">现在不能退出，也不再接受报名</text>
        </view>
        <view wx:else class="flex1 col gap-2">
          <text class="t-15 w7">最晚 {{event.exitDeadlineLabel}} 前可以退出</text>
          <text class="t-13 c-2">到时候人够了自动成群，不够就取消</text>
        </view>
      </view>
    </view>

    <view wx:if="{{event.description}}" class="desc">{{event.description}}</view>

    <view class="col gap-10">
      <view class="row between">
        <text class="t-15 w7">同行的人</text>
        <text class="t-13 c-2">{{event.memberCount}}/{{event.capacity}} · 点头像看主页</text>
      </view>
      <scroll-view scroll-x enhanced="{{true}}" show-scrollbar="{{false}}" class="members-scroll">
        <view class="members">
          <view wx:for="{{members}}" wx:key="id" class="member" hover-class="pressed" data-id="{{item.id}}" bindtap="openUser">
            <dz-avatar user="{{item}}" size="44" />
            <text class="member-name">{{item.nickname}}</text>
          </view>
          <view wx:for="{{seats}}" wx:key="*this" class="member">
            <view class="seat seat-44"><image class="ico-18" src="/assets/icons/plus-gray.svg" /></view>
            <text class="member-name">{{index === 0 && canWait ? '等你' : '空位'}}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <view wx:if="{{applications.length}}" class="apps">
      <view class="t-15 w7">报名申请 · {{applications.length}}</view>
      <view wx:for="{{applications}}" wx:key="id" class="app-row">
        <view data-id="{{item.id}}" bindtap="openUser"><dz-avatar user="{{item}}" size="36" /></view>
        <view class="flex1 col">
          <text class="t-15 w5 ellipsis">{{item.nickname}}</text>
          <text class="t-12 c-2">履约 {{item.creditRate}}%</text>
        </view>
        <view class="btn btn-xs btn-outline" hover-class="pressed" data-id="{{item.id}}" bindtap="rejectApp">婉拒</view>
        <view class="btn btn-xs btn-primary" hover-class="pressed" data-id="{{item.id}}" bindtap="approveApp">同意</view>
      </view>
    </view>

    <view class="tip-box">
      <image class="ico-18 tip-ico" src="/assets/icons/shield-check-body.svg" />
      <text>活动由参与者自发组织，平台不收费。请在公共场所见面，量力而行。活动前一天会提醒你确认出席。</text>
    </view>

    <view wx:if="{{leave}}" class="leave">
      <view class="leave-btn {{leave.disabled ? 'off' : ''}}" hover-class="{{leave.disabled ? 'none' : 'pressed'}}" bindtap="leaveEvent" aria-role="button" aria-disabled="{{leave.disabled}}">
        <image class="ico-16" src="{{leave.disabled ? '/assets/icons/lock-gray.svg' : '/assets/icons/exit-danger.svg'}}" />
        <text>{{leave.label}}</text>
      </view>
      <text wx:if="{{leave.disabled}}" class="leave-reason">{{leave.reason}}</text>
    </view>
    <view wx:if="{{canCancel}}" class="host-cancel" hover-class="pressed" bindtap="cancelEvent">取消这个局</view>

    <view class="bar-space"></view>
  </view>

  <view class="bottom-bar bar">
    <block wx:if="{{bar.mode === 'waiting'}}">
      <view class="flex1 col gap-6">
        <text class="t-14 w7">已加入 · 还差 {{bar.remaining}} 人成群</text>
        <view class="progress"><view class="progress-bar" style="width: {{fillPct}}%;"></view></view>
        <text class="t-12 c-2">人齐了第一时间通知你</text>
      </view>
      <button class="native-btn" open-type="share" hover-class="none">
        <view class="btn btn-md btn-primary cta" hover-class="pressed">
          <image class="ico-16" src="/assets/icons/share-white.svg" />
          <text>邀请朋友</text>
        </view>
      </button>
    </block>
    <block wx:else>
      <view class="flex1 col gap-6">
        <text class="t-14 w7">{{slotText}}</text>
        <view class="progress"><view class="progress-bar" style="width: {{fillPct}}%;"></view></view>
      </view>
      <view class="btn btn-md btn-primary cta {{bar.disabled ? 'disabled' : ''}}" hover-class="{{bar.disabled ? 'none' : 'pressed'}}" bindtap="onCta" aria-disabled="{{bar.disabled}}">{{bar.label}}</view>
    </block>
  </view>
</view>

<dz-join-sheet show="{{joinShow}}" info="{{joinInfo}}" busy="{{joinBusy}}" result="{{joinResult}}" bindclose="closeJoin" bindconfirm="confirmJoin" bindchat="joinChat" />
