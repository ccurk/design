.form {
  padding: 16rpx 32rpx 0;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}
.box {
  padding: 32rpx;
  border-radius: 48rpx;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.text {
  width: 100%;
  height: 200rpx;
  font-size: 32rpx;
  line-height: 1.6;
}
.count {
  text-align: right;
  font-size: 24rpx;
  color: var(--text-2);
}
