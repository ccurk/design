.post-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}
.scroll {
  flex: 1;
  height: 0;
}
page {
  background: #FFFFFF;
}
.gallery {
  position: relative;
  background: var(--stone);
}
.gallery-img {
  display: block;
  width: 100%;
  height: 100%;
}
.dots {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 20rpx;
  display: flex;
  justify-content: center;
  gap: 10rpx;
}
.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.55);
}
.dot.on {
  width: 28rpx;
  background: #FFFFFF;
}
.gallery-count {
  position: absolute;
  right: 24rpx;
  top: 24rpx;
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(21, 23, 28, 0.55);
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 700;
}
.inner {
  padding: 16rpx 32rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.author {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.author-main {
  flex: 1;
  min-width: 0;
  min-height: 96rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.round {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.text {
  padding: 0 4rpx;
  font-size: 32rpx;
  line-height: 1.65;
  white-space: pre-wrap;
  word-break: break-all;
}
.from {
  align-self: flex-start;
  max-width: 100%;
  min-height: 88rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: var(--ground);
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 26rpx;
  font-weight: 700;
}
.acts {
  display: flex;
  gap: 8rpx;
  padding-bottom: 20rpx;
  border-bottom: 1px solid var(--divider);
}
.act {
  min-width: 120rpx;
  min-height: 88rpx;
  padding: 0 12rpx 0 4rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 28rpx;
}
.count-head {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  padding: 0 8rpx;
}
.no-comment {
  padding: 8rpx 8rpx 24rpx;
  font-size: 26rpx;
  color: var(--text-2);
}
.comment {
  display: flex;
  gap: 20rpx;
  padding: 0 8rpx;
}
.comment-av {
  flex-shrink: 0;
  margin-top: 12rpx;
}
.comment-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 88rpx;
}
.reply {
  margin-left: auto;
  min-height: 88rpx;
  padding: 0 8rpx 0 24rpx;
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: var(--text-2);
}
.comment-text {
  font-size: 30rpx;
  line-height: 1.55;
  word-break: break-all;
}
.end {
  height: 2rpx;
}
.composer {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1px solid var(--hairline);
}
.composer-input {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  border: 1px solid var(--outline);
  font-size: 30rpx;
}
.send-btn {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  border-radius: 999rpx;
  background: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
}
