.seg {
  margin: 16rpx 32rpx 0;
  padding: 8rpx;
  border-radius: 999rpx;
  background: var(--pill);
  display: flex;
  gap: 8rpx;
}
.seg-item {
  flex: 1;
  min-height: 88rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
}
.seg-item.on {
  background: #FFFFFF;
  font-weight: 700;
}
.list {
  padding: 28rpx 32rpx calc(60rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.card-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx;
  border-radius: 44rpx;
  background: #FFFFFF;
}
.gap-4 {
  gap: 8rpx;
}
.row-pill {
  align-self: flex-start;
  padding: 6rpx 16rpx;
  font-size: 22rpx;
}
.review-btn {
  flex-shrink: 0;
  font-size: 28rpx;
  padding: 0 32rpx;
}
