# 活动搭子后端配置示例：复制为 .env 后按需修改（.env 不要提交到仓库）

# 运行环境：development / production / test
NODE_ENV=development

# HTTP 端口
PORT=3000

# SQLite 数据库文件（相对 server/ 目录）；测试可用 :memory:
DB_PATH=data/dazi.db

# 后台登录密码。开发环境不填默认 admin123；生产环境必须设置，否则拒绝启动
ADMIN_PASSWORD=

# 微信小程序 AppID / AppSecret（小程序后台「开发管理 → 开发设置」）。
# 不填 = 开发模式：openid = dev_<code>，手机号随机生成（生产环境不填则登录不可用）
WX_APPID=
WX_SECRET=

# 对外访问地址，用于拼接上传图片的 URL（默认 http://localhost:PORT）
PUBLIC_BASE_URL=

# 可选：上传目录（默认 uploads）、后台前端目录（默认 ../admin）、日志级别（debug/info/warn/error/silent）
# UPLOAD_DIR=uploads
# ADMIN_DIR=../admin
# LOG_LEVEL=info

# 可选：JOBS=off 时不启动定时任务（撮合 / 提醒）
# JOBS=off
